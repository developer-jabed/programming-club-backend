# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/programming_club?schema=public

# ── Redis (BullMQ) ──────────────────────────────────────────
BULLMQ_REDIS_URL=redis://localhost:6379

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── JWT (use long random strings, min 32 chars) ─────────────
JWT_ACCESS_SECRET=change-me-to-a-very-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-very-long-random-string-at-least-32
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookie ──────────────────────────────────────────────────
COOKIE_SECRET=another-long-random-secret-for-cookies

# ── Password hashing ────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Admin seed (only used on first boot) ────────────────────
ADMIN_EMAIL=admin@programmingclub.edu
ADMIN_PASSWORD=ChangeThisStrongPassword123!

# ── Cloudinary (optional) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── URLs ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:5000
