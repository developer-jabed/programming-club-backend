generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}




enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum Shift {
  DAY
  MORNING
}

enum SectorMemberRole {
  LEAD
  MENTOR
  MEMBER
}

enum FeatureRequestStatus {
  OPEN
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  COMPLETED
  REJECTED
  DUPLICATE
}

enum FeatureRequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  OWNER
  MENTOR
  MEMBER
}

enum ProjectMemberStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskTargetType {
  ALL_MEMBERS
  SPECIFIC_GROUPS
  SPECIFIC_MEMBERS
  PROJECT_MEMBERS
  SECTOR_MEMBERS
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  CHANGES_REQUESTED
  REJECTED
}

enum TestStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum TestTargetType {
  ALL_MEMBERS
  SPECIFIC_GROUPS
  SPECIFIC_MEMBERS
  PROJECT_MEMBERS
  SECTOR_MEMBERS
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_DEADLINE
  PROJECT_INVITE
  CONTRIBUTION_REQUEST
  CONTRIBUTION_ACCEPTED
  CONTRIBUTION_REJECTED
  CHAT_MENTION
  CHAT_MESSAGE
  TEST_ASSIGNED
  TEST_RESULT
  SUBMISSION_REVIEWED
  OWNERSHIP_TRANSFERRED
  BADGE_EARNED
  SECTOR_JOINED
  SYSTEM
  REMINDER
  PAYMENT_RECEIVED
  
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String?
  role                    UserRole                 @default(MEMBER)
  status                  UserStatus               @default(ACTIVE)
  name                    String
  profilePicture          String?
  phone                   String?
  roll                    String?
  semester                Int?
  shift                   Shift?
  group                   String?
  registration            String?                  @unique
  bloodGroup              String?
  presentAddress          String?
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  ownedProjects           Project[]                @relation("ProjectOwner")
  projectMemberships      ProjectMember[]
  sectorMemberships       SectorMember[]
  invitedProjectMembers ProjectMember[] @relation("ProjectMemberInviter")
  createdTasks            Task[]                   @relation("TaskCreator")
  taskAssignments         TaskAssignment[]
  taskSubmissions         TaskSubmission[]
  reviewedSubmissions     TaskSubmission[]         @relation("SubmissionReviewer")
  projectSubmissions      ProjectSubmission[]
  reviewedProjectSubs     ProjectSubmission[]      @relation("ProjectSubmissionReviewer")
  createdTests            Test[]                   @relation("TestCreator")
  testAssignments         TestAssignment[]
  testAttempts            TestAttempt[]
  chatMessages            ChatMessage[]
  notifications           Notification[]
  notificationPreferences NotificationPreference?
  badges                  UserBadge[]
  portfolio               Portfolio?

  createdFeatureRequests   FeatureRequest[]      @relation("FeatureRequestCreator")
  resolvedFeatureRequests  FeatureRequest[]      @relation("FeatureRequestResolver")
  featureRequestReplies    FeatureRequestReply[]
  featureUpdates           FeatureUpdate[]       @relation("FeatureUpdateAuthor")
  dues              Due[]
  createdDues       Due[]      @relation("DueCreator")
  payments          Payment[]  @relation("PaymentPayer")
  receivedPayments  Payment[]  @relation("PaymentReceiver")
  voidedPayments    Payment[]  @relation("PaymentVoider")
  featureRequestVotes FeatureRequestVote[]
  recordedExpenses Expense[] @relation("ExpenseRecorder")
  voidedExpenses   Expense[] @relation("ExpenseVoider")

  @@index([role, status])
  @@index([email])
  @@index([group, semester])
  @@map("users")

}

model Sector {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String?
  icon        String?
  color       String?
  isActive    Boolean        @default(true)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  projects    Project[]
  tasks       Task[]
  tests       Test[]
  members     SectorMember[]
  featureRequests FeatureRequest[]
  featureUpdates  FeatureUpdate[]
  expenses Expense[]

  @@map("sectors")
}

model SectorMember {
  id       String           @id @default(cuid())
  sectorId String
  userId   String
  role     SectorMemberRole @default(MEMBER)
  joinedAt DateTime         @default(now())
  sector   Sector           @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sectorId, userId])
  @@index([userId])
  @@map("sector_members")
}

model Project {
  id           String              @id @default(cuid())
  title        String
  description  String?
  status       ProjectStatus       @default(OPEN)
  isPublic     Boolean             @default(true)
  maxMembers   Int?
  startDate    DateTime?
  endDate      DateTime?
  tags         String[]
  ownerId      String
  owner        User                @relation("ProjectOwner", fields: [ownerId], references: [id])
  sectorId     String?
  sector       Sector?             @relation(fields: [sectorId], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  members      ProjectMember[]
  tasks        Task[]
  chatMessages ChatMessage[]
  submissions  ProjectSubmission[]
  tests        Test[]
  featureRequests FeatureRequest[]
  expenses Expense[]

  @@index([ownerId])
  @@index([sectorId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String              @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole   @default(MEMBER)
  status    ProjectMemberStatus @default(PENDING)

  invitedById String?
  invitedBy   User?   @relation("ProjectMemberInviter", fields: [invitedById], references: [id])
  joinedAt  DateTime?
  leftAt    DateTime?
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([projectId, userId])
  @@index([userId, status])
  @@index([projectId, status])
  @@map("project_members")
}

model Task {
  id           String            @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus        @default(TODO)
  priority     TaskPriority      @default(MEDIUM)
  dueDate      DateTime?
  maxScore     Int?
  isMarked     Boolean           @default(false)
  createdById  String
  createdBy    User              @relation("TaskCreator", fields: [createdById], references: [id])
  projectId    String?
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sectorId     String?
  sector       Sector?           @relation(fields: [sectorId], references: [id])
  targetType   TaskTargetType    @default(SPECIFIC_MEMBERS)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignments  TaskAssignment[]
  submissions  TaskSubmission[]
  targetGroups TaskTargetGroup[]

  @@index([createdById])
  @@index([projectId])
  @@index([sectorId])
  @@index([status, dueDate])
  @@map("tasks")
}

model TaskAssignment {
  id          String     @id @default(cuid())
  taskId      String
  userId      String
  status      TaskStatus @default(TODO)
  assignedAt  DateTime   @default(now())
  completedAt DateTime?
  score       Int?
  feedback    String?
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId, status])
  @@map("task_assignments")
}

model TaskTargetGroup {
  id        String @id @default(cuid())
  taskId    String
  groupName String
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, groupName])
  @@map("task_target_groups")
}

model TaskSubmission {
  id           String           @id @default(cuid())
  taskId       String
  userId       String
  content      String?
  link         String?
  fileUrls     String[]
  status       SubmissionStatus @default(SUBMITTED)
  score        Int?
  feedback     String?
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?            @relation("SubmissionReviewer", fields: [reviewedById], references: [id])

  @@index([taskId, userId])
  @@index([status])
  @@map("task_submissions")
}

model ProjectSubmission {
  id            String           @id @default(cuid())
  projectId     String
  submittedById String
  title         String?
  description   String
  link          String
  extraLinks    String[]
  status        SubmissionStatus @default(SUBMITTED)
  score         Int?
  feedback      String?
  submittedAt   DateTime         @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy   User             @relation(fields: [submittedById], references: [id])
  reviewedBy    User?            @relation("ProjectSubmissionReviewer", fields: [reviewedById], references: [id])

  @@index([projectId])
  @@map("project_submissions")
}

model Test {
  id                    String            @id @default(cuid())
  title                 String
  description           String?
  status                TestStatus        @default(DRAFT)
  durationMinutes       Int?
  totalMarks            Int               @default(0)
  passingMarks          Int?
  startAt               DateTime?
  endAt                 DateTime?
  shuffleQuestions      Boolean           @default(true)
  showResultImmediately Boolean           @default(true)
  createdById           String
  createdBy             User              @relation("TestCreator", fields: [createdById], references: [id])
  projectId             String?
  project               Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sectorId              String?
  sector                Sector?           @relation(fields: [sectorId], references: [id])
  targetType            TestTargetType    @default(SPECIFIC_MEMBERS)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  questions             Question[]
  assignments           TestAssignment[]
  attempts              TestAttempt[]
  targetGroups          TestTargetGroup[]

  @@index([createdById])
  @@index([sectorId])
  @@index([status])
  @@map("tests")
}

model Question {
  id           String           @id @default(cuid())
  testId       String
  questionText String
  type         QuestionType     @default(SINGLE_CHOICE)
  marks        Int              @default(1)
  explanation  String?
  order        Int              @default(0)
  test         Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  options      QuestionOption[]
  answers      TestAnswer[]

  @@index([testId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  optionText String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

model TestAssignment {
  id         String   @id @default(cuid())
  testId     String
  userId     String
  assignedAt DateTime @default(now())
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([testId, userId])
  @@map("test_assignments")
}

model TestTargetGroup {
  id        String @id @default(cuid())
  testId    String
  groupName String
  test      Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, groupName])
  @@map("test_target_groups")
}

model TestAttempt {
  id           String        @id @default(cuid())
  testId       String
  userId       String
  status       AttemptStatus @default(IN_PROGRESS)
  score        Int?
  percentage   Float?
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  timeTakenSec Int?
  test         Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      TestAnswer[]

  @@unique([testId, userId])
  @@index([userId])
  @@map("test_attempts")
}

model TestAnswer {
  id              String      @id @default(cuid())
  attemptId       String
  questionId      String
  selectedOptions String[]
  isCorrect       Boolean?
  marksObtained   Int?
  attempt         TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("test_answers")
}

model ChatMessage {
  id          String        @id @default(cuid())
  projectId   String
  senderId    String
  content     String
  isSystem    Boolean       @default(false)
  replyToId   String?
  attachments String[]
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender      User          @relation(fields: [senderId], references: [id])
  replyTo     ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     ChatMessage[] @relation("MessageReplies")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([projectId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model Notification {
  id         String              @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  isRead     Boolean             @default(false)
  channel    NotificationChannel @default(IN_APP)
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime            @default(now())
  readAt     DateTime?
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  emailEnabled     Boolean @default(true)
  inAppEnabled     Boolean @default(true)
  taskAssigned     Boolean @default(true)
  deadlineReminder Boolean @default(true)
  chatMention      Boolean @default(true)
  testAssigned     Boolean @default(true)
  contributionReq  Boolean @default(true)
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  iconUrl     String?
  criteria    String?
  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Portfolio {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?
  skills      String[]
  githubUrl   String?
  linkedinUrl String?
  websiteUrl  String?
  isPublic    Boolean  @default(true)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}


model FeatureRequest {
  id          String                 @id @default(cuid())
  title       String
  description String
  status      FeatureRequestStatus   @default(OPEN)
  priority    FeatureRequestPriority @default(MEDIUM)
  votes       Int                    @default(0)

  // Who submitted
  createdById String
  createdBy   User                   @relation("FeatureRequestCreator", fields: [createdById], references: [id])

  // Optional relations
  sectorId    String?
  sector      Sector?                @relation(fields: [sectorId], references: [id])
  projectId   String?
  project     Project?               @relation(fields: [projectId], references: [id])

  // Admin response summary
  adminNote    String?
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?                 @relation("FeatureRequestResolver", fields: [resolvedById], references: [id])

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  // Relations
  replies         FeatureRequestReply[]
  relatedUpdates  FeatureUpdate[]          // ← opposite side of FeatureUpdate.relatedFeatureRequest
  voteRecords FeatureRequestVote[]

  @@index([status, createdAt])
  @@index([createdById])
  @@index([sectorId])
  @@index([projectId])
  @@map("feature_requests")
}

model FeatureRequestReply {
  id               String         @id @default(cuid())
  featureRequestId String
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)

  content          String
  isAdminReply     Boolean        @default(false) // true when admin/moderator replies

  authorId         String
  author           User           @relation(fields: [authorId], references: [id])

  // Optional reply-to (threaded)
  parentReplyId    String?
  parentReply      FeatureRequestReply?  @relation("ReplyThread", fields: [parentReplyId], references: [id])
  childReplies     FeatureRequestReply[] @relation("ReplyThread")

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  @@index([featureRequestId, createdAt])
  @@index([authorId])
  @@map("feature_request_replies")
}


model FeatureRequestVote {
  id               String   @id @default(cuid())
  featureRequestId String
  userId           String
  createdAt        DateTime @default(now())

  featureRequest FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([featureRequestId, userId])
  @@index([featureRequestId])
  @@index([userId])
  @@map("feature_request_votes")
}

enum FeatureUpdateType {
  FEATURE_UPDATE
  BUG_FIX
  IMPROVEMENT
  TECHNICAL_REPORT
  ANNOUNCEMENT
  ROADMAP
}

enum FeatureUpdateVisibility {
  PUBLIC          // everyone can see
  MEMBERS_ONLY
  ADMIN_ONLY
}

model FeatureUpdate {
  id          String                   @id @default(cuid())
  title       String
  content     String                   // markdown supported recommended
  type        FeatureUpdateType        @default(FEATURE_UPDATE)
  visibility  FeatureUpdateVisibility  @default(PUBLIC)
  isPinned    Boolean                  @default(false)

  // Version / release info (optional)
  version     String?
  tags        String[]

  // Who posted (usually admin/moderator)
  authorId    String
  author      User                     @relation("FeatureUpdateAuthor", fields: [authorId], references: [id])

  // Optional links
  relatedFeatureRequestId String?
  relatedFeatureRequest   FeatureRequest? @relation(fields: [relatedFeatureRequestId], references: [id])

  sectorId    String?
  sector      Sector?                  @relation(fields: [sectorId], references: [id])

  publishedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([type, publishedAt])
  @@index([visibility, isPinned])
  @@index([authorId])
  @@map("feature_updates")
}


// ─────────────────────────────────────────────
// Payments (offline / cash, recorded by admin)
// ─────────────────────────────────────────────

enum PaymentCategoryType {
  MONTHLY     // recurring, one due per month
  ONE_TIME    // admission, event fee, fine, donation, etc.
}

enum DueStatus {
  UNPAID
  PARTIAL
  PAID
  WAIVED
}

enum PaymentStatus {
  RECEIVED
  VOIDED      // recorded by mistake; reverses the due
}

// What the money is for: "Monthly Fee", "Admission", "Event Fee", "Fine"...
model PaymentCategory {
  id          String              @id @default(cuid())
  name        String              @unique
  slug        String              @unique
  description String?
  type        PaymentCategoryType @default(ONE_TIME)
  amount      Int                 @default(0) // default amount in BDT, can be overridden per due
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  dues        Due[]
  payments    Payment[]

  @@map("payment_categories")
}

// What a member owes (one row per member, category and month)
model Due {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    PaymentCategory @relation(fields: [categoryId], references: [id])

  title       String?         // e.g. "Hackathon 2026 entry fee"
  year        Int?            // set for MONTHLY dues
  month       Int?            // 1-12, set for MONTHLY dues
  amount      Int
  paidAmount  Int             @default(0)
  status      DueStatus       @default(UNPAID)
  dueDate     DateTime?
  note        String?

  createdById String?
  createdBy   User?           @relation("DueCreator", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  payments    Payment[]

  @@unique([userId, categoryId, year, month]) // blocks duplicate monthly dues
  @@index([userId, status])
  @@index([categoryId, year, month])
  @@index([status, dueDate])
  @@map("dues")
}


model Payment {
  id           String          @id @default(cuid())
  receiptNo    Int             @unique @default(autoincrement())

  userId       String          // who paid
  user         User            @relation("PaymentPayer", fields: [userId], references: [id])
  categoryId   String
  category     PaymentCategory @relation(fields: [categoryId], references: [id])
  dueId        String?         // null for standalone payments (donation, etc.)
  due          Due?            @relation(fields: [dueId], references: [id], onDelete: SetNull)

  amount       Int
  status       PaymentStatus   @default(RECEIVED)
  paidAt       DateTime        @default(now())
  note         String?

  receivedById String          // admin/moderator who collected the cash
  receivedBy   User            @relation("PaymentReceiver", fields: [receivedById], references: [id])

  voidedAt     DateTime?
  voidedById   String?
  voidedBy     User?           @relation("PaymentVoider", fields: [voidedById], references: [id])
  voidReason   String?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, paidAt])
  @@index([dueId])
  @@index([categoryId, paidAt])
  @@index([receivedById, paidAt])
  @@map("payments")
}



enum ExpenseStatus {
  RECORDED
  VOIDED
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String    @unique   // Event, Food, Hosting, Equipment, Prize, Other
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expenses    Expense[]

  @@map("expense_categories")
}

model Expense {
  id           String          @id @default(cuid())
  expenseNo    Int             @unique @default(autoincrement())

  categoryId   String
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])

  title        String          // short: "Pizza for hackathon"
  description  String          // required: what and why
  amount       Int             // BDT
  spentAt      DateTime        @default(now())
  paidTo       String?         // vendor or person
  receiptUrl   String?         // Cloudinary link to bill photo

  // Optional links
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sectorId     String?
  sector       Sector?         @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  status       ExpenseStatus   @default(RECORDED)

  recordedById String
  recordedBy   User            @relation("ExpenseRecorder", fields: [recordedById], references: [id])

  voidedAt     DateTime?
  voidedById   String?
  voidedBy     User?           @relation("ExpenseVoider", fields: [voidedById], references: [id])
  voidReason   String?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, spentAt])
  @@index([categoryId, spentAt])
  @@index([recordedById])
  @@index([projectId])
  @@map("expenses")
}