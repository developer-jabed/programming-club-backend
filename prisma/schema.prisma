generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}




enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum Shift {
  DAY
  EVENING
  NIGHT
}

enum SectorMemberRole {
  LEAD
  MENTOR
  MEMBER
}

enum ProjectStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  OWNER
  MENTOR
  MEMBER
}

enum ProjectMemberStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskTargetType {
  ALL_MEMBERS
  SPECIFIC_GROUPS
  SPECIFIC_MEMBERS
  PROJECT_MEMBERS
  SECTOR_MEMBERS
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  CHANGES_REQUESTED
  REJECTED
}

enum TestStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum TestTargetType {
  ALL_MEMBERS
  SPECIFIC_GROUPS
  SPECIFIC_MEMBERS
  PROJECT_MEMBERS
  SECTOR_MEMBERS
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_DEADLINE
  PROJECT_INVITE
  CONTRIBUTION_REQUEST
  CONTRIBUTION_ACCEPTED
  CONTRIBUTION_REJECTED
  CHAT_MENTION
  CHAT_MESSAGE
  TEST_ASSIGNED
  TEST_RESULT
  SUBMISSION_REVIEWED
  OWNERSHIP_TRANSFERRED
  BADGE_EARNED
  SECTOR_JOINED
  SYSTEM
  REMINDER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String?
  role                    UserRole                 @default(MEMBER)
  status                  UserStatus               @default(ACTIVE)
  name                    String
  profilePicture          String?
  phone                   String?
  roll                    String?
  semester                Int?
  shift                   Shift?
  group                   String?
  registration            String?                  @unique
  bloodGroup              String?
  presentAddress          String?
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  ownedProjects           Project[]                @relation("ProjectOwner")
  projectMemberships      ProjectMember[]
  sectorMemberships       SectorMember[]
  invitedProjectMembers ProjectMember[] @relation("ProjectMemberInviter")
  createdTasks            Task[]                   @relation("TaskCreator")
  taskAssignments         TaskAssignment[]
  taskSubmissions         TaskSubmission[]
  reviewedSubmissions     TaskSubmission[]         @relation("SubmissionReviewer")
  projectSubmissions      ProjectSubmission[]
  reviewedProjectSubs     ProjectSubmission[]      @relation("ProjectSubmissionReviewer")
  createdTests            Test[]                   @relation("TestCreator")
  testAssignments         TestAssignment[]
  testAttempts            TestAttempt[]
  chatMessages            ChatMessage[]
  notifications           Notification[]
  notificationPreferences NotificationPreference?
  badges                  UserBadge[]
  portfolio               Portfolio?

  @@index([role, status])
  @@index([email])
  @@index([group, semester])
  @@map("users")
}

model Sector {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String?
  icon        String?
  color       String?
  isActive    Boolean        @default(true)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  projects    Project[]
  tasks       Task[]
  tests       Test[]
  members     SectorMember[]

  @@map("sectors")
}

model SectorMember {
  id       String           @id @default(cuid())
  sectorId String
  userId   String
  role     SectorMemberRole @default(MEMBER)
  joinedAt DateTime         @default(now())
  sector   Sector           @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sectorId, userId])
  @@index([userId])
  @@map("sector_members")
}

model Project {
  id           String              @id @default(cuid())
  title        String
  description  String?
  status       ProjectStatus       @default(OPEN)
  isPublic     Boolean             @default(true)
  maxMembers   Int?
  startDate    DateTime?
  endDate      DateTime?
  tags         String[]
  ownerId      String
  owner        User                @relation("ProjectOwner", fields: [ownerId], references: [id])
  sectorId     String?
  sector       Sector?             @relation(fields: [sectorId], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  members      ProjectMember[]
  tasks        Task[]
  chatMessages ChatMessage[]
  submissions  ProjectSubmission[]
  tests        Test[]

  @@index([ownerId])
  @@index([sectorId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String              @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole   @default(MEMBER)
  status    ProjectMemberStatus @default(PENDING)

  invitedById String?
  invitedBy   User?   @relation("ProjectMemberInviter", fields: [invitedById], references: [id])
  joinedAt  DateTime?
  leftAt    DateTime?
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([projectId, userId])
  @@index([userId, status])
  @@index([projectId, status])
  @@map("project_members")
}

model Task {
  id           String            @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus        @default(TODO)
  priority     TaskPriority      @default(MEDIUM)
  dueDate      DateTime?
  maxScore     Int?
  isMarked     Boolean           @default(false)
  createdById  String
  createdBy    User              @relation("TaskCreator", fields: [createdById], references: [id])
  projectId    String?
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sectorId     String?
  sector       Sector?           @relation(fields: [sectorId], references: [id])
  targetType   TaskTargetType    @default(SPECIFIC_MEMBERS)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignments  TaskAssignment[]
  submissions  TaskSubmission[]
  targetGroups TaskTargetGroup[]

  @@index([createdById])
  @@index([projectId])
  @@index([sectorId])
  @@index([status, dueDate])
  @@map("tasks")
}

model TaskAssignment {
  id          String     @id @default(cuid())
  taskId      String
  userId      String
  status      TaskStatus @default(TODO)
  assignedAt  DateTime   @default(now())
  completedAt DateTime?
  score       Int?
  feedback    String?
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId, status])
  @@map("task_assignments")
}

model TaskTargetGroup {
  id        String @id @default(cuid())
  taskId    String
  groupName String
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, groupName])
  @@map("task_target_groups")
}

model TaskSubmission {
  id           String           @id @default(cuid())
  taskId       String
  userId       String
  content      String?
  link         String?
  fileUrls     String[]
  status       SubmissionStatus @default(SUBMITTED)
  score        Int?
  feedback     String?
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?            @relation("SubmissionReviewer", fields: [reviewedById], references: [id])

  @@index([taskId, userId])
  @@index([status])
  @@map("task_submissions")
}

model ProjectSubmission {
  id            String           @id @default(cuid())
  projectId     String
  submittedById String
  title         String?
  description   String
  link          String
  extraLinks    String[]
  status        SubmissionStatus @default(SUBMITTED)
  score         Int?
  feedback      String?
  submittedAt   DateTime         @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy   User             @relation(fields: [submittedById], references: [id])
  reviewedBy    User?            @relation("ProjectSubmissionReviewer", fields: [reviewedById], references: [id])

  @@index([projectId])
  @@map("project_submissions")
}

model Test {
  id                    String            @id @default(cuid())
  title                 String
  description           String?
  status                TestStatus        @default(DRAFT)
  durationMinutes       Int?
  totalMarks            Int               @default(0)
  passingMarks          Int?
  startAt               DateTime?
  endAt                 DateTime?
  shuffleQuestions      Boolean           @default(true)
  showResultImmediately Boolean           @default(true)
  createdById           String
  createdBy             User              @relation("TestCreator", fields: [createdById], references: [id])
  projectId             String?
  project               Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sectorId              String?
  sector                Sector?           @relation(fields: [sectorId], references: [id])
  targetType            TestTargetType    @default(SPECIFIC_MEMBERS)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  questions             Question[]
  assignments           TestAssignment[]
  attempts              TestAttempt[]
  targetGroups          TestTargetGroup[]

  @@index([createdById])
  @@index([sectorId])
  @@index([status])
  @@map("tests")
}

model Question {
  id           String           @id @default(cuid())
  testId       String
  questionText String
  type         QuestionType     @default(SINGLE_CHOICE)
  marks        Int              @default(1)
  explanation  String?
  order        Int              @default(0)
  test         Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  options      QuestionOption[]
  answers      TestAnswer[]

  @@index([testId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  optionText String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

model TestAssignment {
  id         String   @id @default(cuid())
  testId     String
  userId     String
  assignedAt DateTime @default(now())
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([testId, userId])
  @@map("test_assignments")
}

model TestTargetGroup {
  id        String @id @default(cuid())
  testId    String
  groupName String
  test      Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, groupName])
  @@map("test_target_groups")
}

model TestAttempt {
  id           String        @id @default(cuid())
  testId       String
  userId       String
  status       AttemptStatus @default(IN_PROGRESS)
  score        Int?
  percentage   Float?
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  timeTakenSec Int?
  test         Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      TestAnswer[]

  @@unique([testId, userId])
  @@index([userId])
  @@map("test_attempts")
}

model TestAnswer {
  id              String      @id @default(cuid())
  attemptId       String
  questionId      String
  selectedOptions String[]
  isCorrect       Boolean?
  marksObtained   Int?
  attempt         TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("test_answers")
}

model ChatMessage {
  id          String        @id @default(cuid())
  projectId   String
  senderId    String
  content     String
  isSystem    Boolean       @default(false)
  replyToId   String?
  attachments String[]
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender      User          @relation(fields: [senderId], references: [id])
  replyTo     ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     ChatMessage[] @relation("MessageReplies")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([projectId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model Notification {
  id         String              @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  isRead     Boolean             @default(false)
  channel    NotificationChannel @default(IN_APP)
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime            @default(now())
  readAt     DateTime?
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  emailEnabled     Boolean @default(true)
  inAppEnabled     Boolean @default(true)
  taskAssigned     Boolean @default(true)
  deadlineReminder Boolean @default(true)
  chatMention      Boolean @default(true)
  testAssigned     Boolean @default(true)
  contributionReq  Boolean @default(true)
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  iconUrl     String?
  criteria    String?
  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Portfolio {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?
  skills      String[]
  githubUrl   String?
  linkedinUrl String?
  websiteUrl  String?
  isPublic    Boolean  @default(true)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}